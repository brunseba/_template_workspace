  <diagram id="30d605842ade48b6" name="Sample Sequence Sequencediagram">
    <mxGraphModel dx="706" dy="604" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;:&quot;sequenceDiagram\n    participant A as Alice\n    participant B as Bob\n    participant C as Charlie\n    \n    A-&gt;&gt;B: Hello Bob, how are you?\n    B--&gt;&gt;A: I&#x27;m fine, thanks!\n    A-&gt;&gt;C: How about you Charlie?\n    C--&gt;&gt;A: I&#x27;m doing well too!\n    \n    Note over A,C: This is a note spanning multiple participants\n    \n    A-&gt;&gt;B: Let&#x27;s meet up\n    B-&gt;&gt;C: Are you free?\n    C--&gt;&gt;B: Yes, I&#x27;m available\n    B--&gt;&gt;A: Charlie can join us&quot;}" id="8c43d33ff7084be2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="260" y="130" width="200" height="200" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="1f1fb133639d4e5d" name="Sample Sequence Sequencediagram 2">
    <mxGraphModel dx="706" dy="604" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&quot;data&quot;:&quot;sequenceDiagram\n    participant U as User\n    participant C as Client\n    participant S as Server\n    participant D as Database\n    \n    U-&gt;&gt;C: Enter credentials\n    C-&gt;&gt;S: Login request\n    S-&gt;&gt;D: Validate user\n    D--&gt;&gt;S: User data\n    S--&gt;&gt;C: Authentication token\n    C--&gt;&gt;U: Login successful\n    \n    Note over U,D: User is now authenticated\n    \n    U-&gt;&gt;C: Request protected resource\n    C-&gt;&gt;S: API call with token\n    S-&gt;&gt;S: Validate token\n    S--&gt;&gt;C: Protected data\n    C--&gt;&gt;U: Display data&quot;}" id="62ae42fd3cb441d5">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
